{
  "name": "ocv-front",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-staging": "ng build --configuration staging --output-path=dist/staging",
    "build-prod": "ng build --prod",
    "jcc": "jest --clearCache",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "test:ci": "CI=true npm test -- --coverage --testResultsProcessor=jest-sonar-reporter --runInBand",
    "lint": "ng lint",
    "deploy": "firebase deploy --project cv-mikeonline",
    "release": "standard-version",
    "deploy-test": "git tag -f deploy && git push -f origin deploy",
    "sonar-test": "git tag -f sonar && git push -f upstream sonar"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~13.2.0",
    "@angular/cdk": "^13.2.5",
    "@angular/common": "~13.2.0",
    "@angular/compiler": "~13.2.0",
    "@angular/core": "~13.2.0",
    "@angular/forms": "~13.2.0",
    "@angular/material": "^13.2.5",
    "@angular/platform-browser": "~13.2.0",
    "@angular/platform-browser-dynamic": "~13.2.0",
    "@angular/router": "~13.2.0",
    "@angular/service-worker": "~13.2.0",
    "@fortawesome/angular-fontawesome": "0.10.1",
    "@fortawesome/fontawesome-svg-core": "1.3.0",
    "@ngrx/effects": "^13.0.2",
    "@ngrx/entity": "^13.0.2",
    "@ngrx/store": "^13.0.2",
    "@ngrx/store-devtools": "^13.0.2",
    "dayjs": "^1.10.8",
    "hammerjs": "^2.0.8",
    "jquery": "^3.5.1",
    "ng2-mock-component": "^0.2.0",
    "pdfmake": "^0.1.72",
    "primeicons": "^4.1.0",
    "primeng": "13.2.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "wordcloud": "^1.1.2",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-builders/jest": "13.0.3",
    "@angular-devkit/build-angular": "~13.2.5",
    "@angular/cli": "~13.2.5",
    "@angular/compiler-cli": "~13.2.0",
    "@angular/language-service": "13.2.5",
    "@types/jasmine": "~3.10.0",
    "@types/jest": "^27.4.1",
    "@types/node": "^12.11.1",
    "@types/pdfmake": "^0.1.20",
    "firebase-tools": "^9.2.2",
    "jasmine-core": "~4.0.0",
    "jest": "^27.5.1",
    "jest-junit": "^12.0.0",
    "jest-preset-angular": "^11.1.1",
    "jest-sonar-reporter": "^2.0.0",
    "jest-transform-stub": "^2.0.0",
    "ng-mocks": "^11.4.0",
    "ng2-mock-component": "^0.2.0",
    "protractor": "~5.4.0",
    "standard-version": "^9.3.2",
    "ts-jest": "^27.1.3",
    "ts-node": "~7.0.0",
    "typescript": "~4.5.2"
  }
}
