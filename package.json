{
  "name": "ocv-front",
  "version": "1.12.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "cypress-server": "ng serve --port 4201 --configuration cypress",
    "build": "ng build",
    "build-staging": "ng build --configuration staging --output-path=dist/staging",
    "build-prod": "ng build --configuration production",
    "build-deploy-staging-from-local": "npm run build-staging && firebase deploy --project cv-mikeonline --only hosting:cv-mikeonline-staging",
    "build-deploy-prod-from-local": "npm run build-prod && firebase deploy --project cv-mikeonline --only hosting:cv-mikeonline",
    "release": "standard-version",
    "lint": "ng lint",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test-coverage": "vitest run --config vitest.config.mts --coverage",
    "start-cypress-run": "npm run clean-reports && start-server-and-test cypress-server http://localhost:4201 cypress-run",
    "start-cypress-run-junit": "npm run clean-reports && (start-server-and-test cypress-server http://localhost:4201 cypress-run-junit) && npm run merge-reports",
    "start-cypress-run-mochawesome": "npm run clean-reports && start-server-and-test cypress-server http://localhost:4201 cypress-run-mochawesome",
    "start-cypress-run-multi": "npm run clean-reports && (start-server-and-test cypress-server http://localhost:4201 cypress-run-multi) && npm run merge-reports",
    "cypress-run": "cypress run",
    "cypress-run-junit": "cypress run -C cypress-extended-junit-reporter.json",
    "cypress-run-mochawesome": "cypress run -C cypress-extended-mochawesome-reporter.json",
    "cypress-run-multi": "cypress run -C cypress-extended-multi-reporter.json",
    "start-cypress-open": "start-server-and-test cypress-server http://localhost:4201 cypress-open",
    "start-cypress-open-junit": "start-server-and-test cypress-server http://localhost:4201 cypress-open-junit",
    "start-cypress-open-mochawesome": "start-server-and-test cypress-server http://localhost:4201 cypress-open-mochawesome",
    "start-cypress-open-multi": "start-server-and-test cypress-server http://localhost:4201 cypress-open-multi",
    "cypress-open": "cypress open",
    "cypress-open-junit": "cypress open -C cypress-extended-junit-reporter.json",
    "cypress-open-mochawesome": "cypress open -C cypress-extended-mochawesome-reporter",
    "cypress-open-multi": "cypress open -C cypress-extended-multi-reporter",
    "clean-reports": "(if exist cypress\\report (rmdir /s /q cypress\\report)) && (if exist cypress\\results (rmdir /s /q cypress\\results)) && (if exist cypress\\screenshots (rmdir /s /q cypress\\screenshots)) && (if exist cypress\\videos (rmdir /s /q cypress\\videos))",
    "merge-reports": "jrm cypress\\results\\junit.xml \"cypress/results/files/*.xml\" && rmdir /s /q cypress\\results\\files",
    "test:ci": "vitest run --config vitest.config.mts --coverage",
    "cypress:ci": "cypress run --record --parallel -b chrome -C cypress-extended-multi-reporter.json",
    "merge-reports:ci": "jrm ./cypress/results/junit.xml \"./cypress/results/files/*.xml\"",
    "sonar-tag": "git tag -f sonar && git push -f upstream sonar",
    "cypress-tag": "git tag -f cypress && git push -f origin cypress",
    "deploy-staging-tag": "git tag -f deploy && git push -f origin deploy",
    "release-tag": "git tag -f release && git push -f origin release",
    "deploy:prod": "npm run build-prod && firebase deploy --project cv-mikeonline --only hosting:cv-mikeonline"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.1",
    "@angular/cdk": "^21.2.1",
    "@angular/common": "~21.2.1",
    "@angular/compiler": "~21.2.1",
    "@angular/core": "~21.2.1",
    "@angular/forms": "~21.2.1",
    "@angular/material": "^21.2.1",
    "@angular/platform-browser": "~21.2.1",
    "@angular/platform-browser-dynamic": "~21.2.1",
    "@angular/router": "~21.2.1",
    "@angular/service-worker": "~21.2.1",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "6.4.0",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/entity": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngrx/store-devtools": "^19.2.1",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "chart.js": "^4.3.0",
    "dayjs": "^1.11.9",
    "hammerjs": "^2.0.8",
    "jquery": "^3.7.0",
    "ng2-mock-component": "^0.2.0",
    "pdfmake": "^0.3.5",
    "primeicons": "^6.0.1",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "tweetnacl": "^1.0.3",
    "wordcloud": "^1.2.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@analogjs/vitest-angular": "^2.3.1",
    "@angular-devkit/build-angular": "~21.2.1",
    "@angular-eslint/builder": "^21.3.0",
    "@angular-eslint/eslint-plugin": "^21.3.0",
    "@angular-eslint/eslint-plugin-template": "^21.3.0",
    "@angular-eslint/schematics": "^21.3.0",
    "@angular-eslint/template-parser": "^21.3.0",
    "@angular/build": "^21.2.1",
    "@angular/cli": "~21.2.1",
    "@angular/compiler-cli": "~21.2.1",
    "@angular/language-service": "~21.2.1",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^20.3.1",
    "@types/pdfmake": "^0.3.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/ui": "^4.0.18",
    "cypress": "^13.3.0",
    "cypress-junit-reporter": "^1.3.0",
    "cypress-mochawesome-reporter": "^3.2.0",
    "cypress-multi-reporters": "^1.6.0",
    "deepmerge": "^4.3.1",
    "eslint": "^9.39.4",
    "firebase-tools": "^11.0.0",
    "jasmine-core": "~4.6.0",
    "jsdom": "^28.1.0",
    "jspdf": "^2.5.1",
    "junit-report-merger": "^3.0.5",
    "mocha": "^10.2.0",
    "mocha-junit-reporter": "^2.0.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "ng-mocks": "^14.0.0",
    "ng2-mock-component": "^0.2.0",
    "standard-version": "^9.5.0",
    "start-server-and-test": "^1.14.0",
    "ts-node": "~10.9.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
