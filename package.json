{
  "name": "ocv-front",
  "version": "1.10.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "cypress-server": "ng serve --port 4201 --configuration cypress",
    "build": "ng build",
    "build-staging": "ng build --configuration staging --output-path=dist/staging",
    "build-prod": "ng build --prod",
    "build-deploy-staging-from-local": "npm run build-staging && firebase deploy --project cv-mikeonline --only hosting:cv-mikeonline-staging",
    "build-deploy-prod-from-local": "npm run build-prod && firebase deploy --project cv-mikeonline --only hosting:cv-mikeonline",
    "release": "standard-version",
    "jest-clear-cache": "jest --clearCache",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "test:ci": "CI=true npm test -- --coverage --runInBand --testResultsProcessor=jest-sonar-reporter",
    "clean-reports": "if exist cypress\\report (rmdir /s /q cypress\\report) && if exist cypress\\videos (rmdir /s /q cypress\\videos)",
    "start-cypress-run": "npm run clean-reports && start-server-and-test cypress-server http://localhost:4201 cypress-run",
    "start-cypress-open": "start-server-and-test cypress-server http://localhost:4201 cypress-open",
    "cypress-run": "cypress run",
    "cypress-open": "cypress open",
    "cypress:ci": "CI=true npm run cypress-run --browser chrome --parallel --group all-test",
    "lint": "ng lint",
    "sonar-tag": "git tag -f sonar && git push -f upstream sonar",
    "cypress-tag": "git tag -f cypress && git push -f origin cypress",
    "deploy-staging-tag": "git tag -f deploy && git push -f origin deploy",
    "release-tag": "git tag -f release && git push -f origin release"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~13.2.0",
    "@angular/cdk": "^13.2.5",
    "@angular/common": "~13.2.0",
    "@angular/compiler": "~13.2.0",
    "@angular/core": "~13.2.0",
    "@angular/forms": "~13.2.0",
    "@angular/material": "^13.2.5",
    "@angular/platform-browser": "~13.2.0",
    "@angular/platform-browser-dynamic": "~13.2.0",
    "@angular/router": "~13.2.0",
    "@angular/service-worker": "~13.2.0",
    "@fortawesome/angular-fontawesome": "0.10.1",
    "@fortawesome/fontawesome-svg-core": "1.3.0",
    "@ngrx/effects": "^13.0.2",
    "@ngrx/entity": "^13.0.2",
    "@ngrx/store": "^13.0.2",
    "@ngrx/store-devtools": "^13.0.2",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "chart.js": "^3.7.1",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.10.8",
    "hammerjs": "^2.0.8",
    "jquery": "^3.5.1",
    "ng2-mock-component": "^0.2.0",
    "pdfmake": "^0.1.72",
    "primeicons": "^5.0.0",
    "primeng": "13.2.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "wordcloud": "^1.1.2",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-builders/jest": "13.0.3",
    "@angular-devkit/build-angular": "~13.2.5",
    "@angular/cli": "~13.2.5",
    "@angular/compiler-cli": "~13.2.0",
    "@angular/language-service": "13.2.5",
    "@types/crypto-js": "^4.1.1",
    "@types/jasmine": "~3.10.0",
    "@types/jest": "^27.4.1",
    "@types/node": "^12.11.1",
    "@types/pdfmake": "^0.1.20",
    "cypress": "^9.5.3",
    "cypress-jest-adapter": "^0.1.1",
    "cypress-mochawesome-reporter": "^3.0.1",
    "firebase-tools": "^9.2.2",
    "jasmine-core": "~4.0.0",
    "jest": "^27.5.1",
    "jest-junit": "^12.0.0",
    "jest-preset-angular": "^11.1.1",
    "jest-sonar-reporter": "^2.0.0",
    "jest-transform-stub": "^2.0.0",
    "mocha": "^5.2.0",
    "mochawesome": "^4.1.0",
    "mochawesome-merge": "^2.0.1",
    "mochawesome-report-generator": "^4.0.1",
    "ng-mocks": "^11.4.0",
    "ng2-mock-component": "^0.2.0",
    "protractor": "~5.4.0",
    "standard-version": "^9.3.2",
    "start-server-and-test": "^1.14.0",
    "ts-jest": "^27.1.3",
    "ts-node": "~7.0.0",
    "typescript": "~4.5.2"
  }
}
