{
  "name": "ocv-front",
  "version": "1.13.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-staging": "ng build --configuration staging --output-path=dist/staging",
    "build-prod": "ng build --configuration production",
    "build-deploy-staging-from-local": "npm run build-staging && firebase deploy --project cv-mikeonline --only hosting:cv-mikeonline-staging",
    "build-deploy-prod-from-local": "npm run build-prod && firebase deploy --project cv-mikeonline --only hosting:cv-mikeonline",
    "release": "standard-version",
    "lint": "ng lint",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test-coverage": "vitest run --config vitest.config.mts --coverage",
    "test:ci": "vitest run --config vitest.config.mts --coverage",
    "deploy-staging-tag": "git tag -f deploy && git push -f origin deploy",
    "release-tag": "git tag -f release && git push -f origin release",
    "deploy:prod": "npm run build-prod && firebase deploy --project cv-mikeonline --only hosting:cv-mikeonline"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "~21.2.25",
    "@angular/compiler": "~21.2.25",
    "@angular/core": "~21.2.25",
    "@angular/forms": "~21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "~21.2.25",
    "@angular/platform-browser-dynamic": "~21.2.25",
    "@angular/router": "~21.2.25",
    "@angular/service-worker": "~21.2.25",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/entity": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "chart.js": "^4.3.0",
    "dayjs": "^1.11.9",
    "pdfmake": "^0.3.11",
    "primeicons": "^6.0.1",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "tweetnacl": "^1.0.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-devkit/build-angular": "~21.2.26",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "~21.2.26",
    "@angular/cli": "~21.2.26",
    "@angular/compiler-cli": "~21.2.25",
    "@angular/language-service": "~21.2.25",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.4",
    "firebase-tools": "^15.33.0",
    "jsdom": "^28.1.0",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  }
}
